{
  "name": "movie-night",
  "version": "1.0.0",
  "description": "Family movie voting app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node -r dotenv/config server.js",
    "docker:build": "docker build -t movie-night:test .",
    "docker:run": "docker run --rm --env-file .env -p 3003:3000 movie-night:test",
    "docker:test": "npm run docker:build && npm run docker:run"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "grammy": "^1.40.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}